/* 90s Cable TV - Spooky Cable Halloween Edition */

@font-face {
    font-family: 'Fredoka';
    src: url('Fredoka-Bold.woff2') format('woff2');
    font-weight: bold;
    font-display: swap;
}

:root {
    /* Halloween Cable Palette */
    --midnight: #1b1747;
    --indigo: #2a2370;
    --grape: #5b3fa8;
    --pumpkin: #ff8a3d;
    --candy-pink: #ff9ec7;
    --cream: #fff4e0;
    --yellow: #ffe45c;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Fredoka', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #000;
    overflow: hidden;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Fixed 1920x1080 Stage (scaled to fit window) */
.stage {
    position: absolute;
    width: 1920px;
    height: 1080px;
    background: #000;
    transform-origin: center center;
    left: 50%;
    top: 50%;
}

/* Main Video (fills stage) */
.main-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
    transition: all 0.3s ease;
    z-index: 5;
}

/* Picture-in-Picture Mode (video in top-left corner during guide) */
.main-video.pip-mode {
    width: 640px;
    height: 360px;
    top: 80px;
    left: 60px;
    border: 3px solid var(--pumpkin);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.8);
    z-index: 350;  /* Above guide overlay */
}

/* Channel Watermark (authentic 90s cable TV logo) */
.channel-watermark {
    position: absolute;
    bottom: 120px;  /* Above safe zone */
    right: 96px;    /* 5% safe margin */
    background: rgba(27, 23, 71, 0.75);
    border: 2px solid rgba(255, 138, 61, 0.4);
    border-style: outset;
    padding: 8px 16px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 250;
    opacity: 0.85;
    transition: opacity 0.3s;
}

.channel-watermark:hover {
    opacity: 1;
}

.channel-watermark.hidden {
    display: none;
}

.watermark-logo {
    font-size: 32px;
    line-height: 1;
}

.watermark-name {
    font-size: 20px;
    font-weight: bold;
    color: var(--cream);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
    letter-spacing: 1px;
}

/* Power-On Screen */
.power-screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--midnight);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 10000;
}

.power-screen.active {
    display: flex;
}

.power-content {
    text-align: center;
}

.power-logo {
    font-size: 96px;
    font-weight: bold;
    color: var(--pumpkin);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    margin-bottom: 50px;
}

.power-message {
    font-size: 42px;
    color: var(--cream);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    margin-bottom: 30px;
}

.power-greeting {
    font-size: 56px;
    color: var(--candy-pink);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

/* Static Burst Effect */
.static-burst {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><filter id="noise"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4"/></filter><rect width="200" height="200" filter="url(%23noise)" opacity="0.8"/></svg>');
    opacity: 0;
    z-index: 1000;
    pointer-events: none;
    animation: staticFlash 0.3s;
}

.static-burst.hidden {
    display: none;
}

@keyframes staticFlash {
    0%, 100% { opacity: 0; }
    50% { opacity: 0.9; }
}

/* Channel Number Display (top-right, 3 seconds) */
.channel-number {
    position: absolute;
    top: 96px;  /* 5% safe margin */
    right: 96px;
    font-size: 160px;
    font-weight: bold;
    color: var(--pumpkin);
    text-shadow: 5px 5px 0 rgba(0,0,0,0.9);
    z-index: 500;
    background: rgba(27, 23, 71, 0.85);
    padding: 20px 50px;
    border: 4px solid var(--pumpkin);
    border-style: outset;
}

.channel-number.hidden {
    display: none;
}

/* Number Entry Display */
.number-entry {
    position: absolute;
    top: 96px;
    right: 96px;
    font-size: 140px;
    font-weight: bold;
    color: var(--yellow);
    text-shadow: 5px 5px 0 rgba(0,0,0,0.9);
    z-index: 500;
    background: rgba(27, 23, 71, 0.9);
    padding: 20px 50px;
    border: 4px solid var(--yellow);
    border-style: outset;
}

.number-entry.hidden {
    display: none;
}

/* Info Banner (bottom bar) */
.info-banner {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 180px;
    background: linear-gradient(to bottom, rgba(27, 23, 71, 0.95), rgba(27, 23, 71, 0.98));
    border-top: 5px solid var(--pumpkin);
    border-style: outset;
    display: none;
    padding: 30px 96px;  /* 5% safe margins */
    z-index: 400;
}

.info-banner.hidden {
    display: none;
}

.info-banner:not(.hidden) {
    display: grid;
    grid-template-columns: 300px 1fr 400px;
    gap: 40px;
    align-items: center;
}

.info-left {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.info-channel-num {
    font-size: 64px;
    font-weight: bold;
    color: var(--pumpkin);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

.info-channel-name {
    font-size: 28px;
    color: var(--candy-pink);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

.info-center {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.info-title {
    font-size: 38px;
    font-weight: bold;
    color: var(--cream);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

.info-time {
    font-size: 28px;
    color: var(--yellow);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

.info-duration {
    font-size: 22px;
    color: var(--candy-pink);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
    margin-top: 4px;
}

.info-progress-bar {
    height: 12px;
    background: rgba(255, 255, 255, 0.2);
    border: 2px solid var(--indigo);
    border-style: inset;
    margin-top: 8px;
}

.info-progress-fill {
    height: 100%;
    background: var(--yellow);
    width: 0%;
    transition: width 0.3s;
}

.info-right {
    text-align: right;
}

.info-next {
    font-size: 24px;
    color: var(--grape);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    margin-bottom: 6px;
}

.info-next-title {
    font-size: 28px;
    color: var(--cream);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    margin-bottom: 4px;
}

.info-next-time {
    font-size: 26px;
    color: var(--candy-pink);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

/* Mini Guide Overlay (bottom third, 5 channels) */
.mini-guide {
    position: absolute;
    bottom: 0;
    left: 96px;  /* 5% safe margin */
    right: 96px;
    height: 360px;
    background: rgba(27, 23, 71, 0.92);
    border: 4px solid var(--pumpkin);
    border-style: outset;
    border-bottom: none;
    z-index: 600;
    padding: 20px;
    display: none;
}

.mini-guide.hidden {
    display: none;
}

.mini-guide:not(.hidden) {
    display: block;
}

.mini-guide-row {
    height: 60px;
    display: grid;
    grid-template-columns: 120px 300px 1fr 180px;
    gap: 20px;
    align-items: center;
    padding: 8px 20px;
    margin-bottom: 4px;
    border: 2px solid transparent;
    background: rgba(42, 35, 112, 0.4);
}

.mini-guide-row.selected {
    background: rgba(255, 138, 61, 0.3);
    border: 2px solid var(--candy-pink);
    border-style: outset;
}

.mini-guide-channel {
    font-size: 42px;
    font-weight: bold;
    color: var(--pumpkin);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

.mini-guide-name {
    font-size: 24px;
    color: var(--cream);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

.mini-guide-show {
    font-size: 28px;
    color: var(--yellow);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mini-guide-time {
    font-size: 24px;
    color: var(--candy-pink);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    text-align: right;
}

.mini-guide-progress {
    grid-column: 2 / -1;
    height: 8px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid var(--indigo);
    margin-top: -4px;
}

.mini-guide-progress-fill {
    height: 100%;
    background: var(--yellow);
}

/* Guide Channel (Ch 1 - Prevue style split screen) */
.guide-channel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--midnight);
    z-index: 300;
    display: none;
}

.guide-channel.hidden {
    display: none;
}

.guide-channel:not(.hidden) {
    display: flex;
    flex-direction: column;
}

/* Top 40%: Promo window + Messages */
.guide-top {
    height: 40%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    padding: 60px 96px;
    background: var(--indigo);
    border-bottom: 6px solid var(--pumpkin);
    border-style: outset;
}

.guide-promo-window {
    background: #000;
    border: 5px solid var(--grape);
    border-style: inset;
    overflow: hidden;
}

.promo-canvas {
    width: 100%;
    height: 100%;
}

.guide-messages {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
}

.guide-message-header {
    font-size: 56px;
    font-weight: bold;
    color: var(--pumpkin);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    text-align: center;
}

.guide-message-body {
    font-size: 38px;
    color: var(--cream);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    text-align: center;
    padding: 30px;
    background: rgba(27, 23, 71, 0.6);
    border: 3px solid var(--grape);
    border-style: outset;
    min-height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.guide-clock {
    font-size: 72px;
    font-weight: bold;
    color: var(--yellow);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    text-align: center;
}

/* Bottom 60%: Scrolling Grid */
.guide-bottom {
    height: 54%;
    background: var(--midnight);
    padding: 20px 96px;
    overflow: hidden;
}

.guide-grid-header {
    display: grid;
    grid-template-columns: 280px repeat(3, 1fr);
    gap: 3px;
    margin-bottom: 3px;
    background: rgba(0,0,0,0.5);
    padding: 2px;
}

.guide-time-header {
    background: var(--indigo);
    border: 3px solid var(--grape);
    border-style: outset;
    padding: 15px;
    font-size: 32px;
    font-weight: bold;
    color: var(--yellow);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    text-align: center;
}

.guide-grid-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.guide-channel-row {
    display: grid;
    grid-template-columns: 280px repeat(3, 1fr);
    gap: 3px;
    background: rgba(0,0,0,0.5);
    padding: 2px;
}

.guide-channel-cell {
    background: var(--indigo);
    border: 3px solid var(--grape);
    border-style: outset;
    padding: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.guide-ch-num {
    font-size: 36px;
    font-weight: bold;
    color: var(--pumpkin);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

.guide-ch-name {
    font-size: 22px;
    color: var(--cream);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
    text-align: center;
    line-height: 1.2;
}

.guide-program-cell {
    background: rgba(42, 35, 112, 0.8);
    border: 2px solid var(--grape);
    border-style: inset;
    padding: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 80px;
}

.guide-program-cell.now-airing {
    color: var(--yellow);
    font-weight: bold;
}

.guide-program-cell:not(.now-airing) {
    color: var(--cream);
}

.guide-program-title {
    font-size: 24px;
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
}

.guide-program-category {
    display: inline-block;
    margin-right: 4px;
    font-size: 20px;
}

.guide-program-duration {
    font-size: 16px;
    color: var(--candy-pink);
    margin-top: 4px;
    opacity: 0.9;
    font-weight: bold;
}

/* Fall color palette for program blocks */
.program-color-0 { background: rgba(255, 138, 61, 0.3) !important; } /* Pumpkin orange */
.program-color-1 { background: rgba(139, 69, 19, 0.3) !important; } /* Saddle brown */
.program-color-2 { background: rgba(218, 165, 32, 0.3) !important; } /* Goldenrod */
.program-color-3 { background: rgba(160, 82, 45, 0.3) !important; } /* Sienna */
.program-color-4 { background: rgba(205, 133, 63, 0.3) !important; } /* Peru */
.program-color-5 { background: rgba(184, 134, 11, 0.3) !important; } /* Dark goldenrod */
.program-color-6 { background: rgba(139, 90, 43, 0.3) !important; } /* Dark brown */
.program-color-7 { background: rgba(210, 105, 30, 0.3) !important; } /* Chocolate */

/* Footer Strip */
.guide-footer {
    height: 6%;
    background: var(--indigo);
    border-top: 4px solid var(--pumpkin);
    border-style: outset;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 96px;
    font-size: 28px;
    color: var(--cream);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

.guide-footer-tip {
    color: var(--candy-pink);
}

/* Interactive Guide (full grid with cursor) */
.interactive-guide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--midnight);
    z-index: 700;
    display: none;
    flex-direction: column;
}

.interactive-guide.hidden {
    display: none;
}

.interactive-guide:not(.hidden) {
    display: flex;
}

.interactive-guide-header {
    height: 120px;
    background: var(--indigo);
    border-bottom: 6px solid var(--pumpkin);
    border-style: outset;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 96px;
}

.interactive-guide-title {
    font-size: 64px;
    font-weight: bold;
    color: var(--pumpkin);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

.interactive-guide-clock {
    font-size: 56px;
    font-weight: bold;
    color: var(--yellow);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

.interactive-guide-grid {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 30px 96px;
}

.interactive-grid-header {
    display: grid;
    grid-template-columns: 280px repeat(6, 260px);
    gap: 3px;
    margin-bottom: 3px;
}

.interactive-grid-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.interactive-channel-row {
    display: grid;
    grid-template-columns: 280px repeat(6, 260px);
    gap: 3px;
}

.interactive-program-cell {
    background: rgba(42, 35, 112, 0.8);
    border: 3px solid var(--grape);
    border-style: inset;
    padding: 15px 10px;
    min-height: 90px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 22px;
    color: var(--cream);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
}

.interactive-program-cell.now-airing {
    color: var(--yellow);
    font-weight: bold;
}

.interactive-program-cell.selected {
    border: 4px solid var(--pumpkin);
    border-style: outset;
    background: rgba(255, 138, 61, 0.5);
    box-shadow: 0 0 20px rgba(255, 138, 61, 0.8);
}

.interactive-guide-detail {
    height: 160px;
    background: var(--indigo);
    border-top: 4px solid var(--pumpkin);
    border-style: outset;
    padding: 20px 96px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 40px;
    align-items: center;
}

.interactive-detail-left {
    font-size: 28px;
    color: var(--cream);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
}

.interactive-detail-title {
    font-size: 42px;
    font-weight: bold;
    color: var(--pumpkin);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    margin-bottom: 10px;
}

.interactive-detail-info {
    font-size: 28px;
    color: var(--yellow);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
}

.interactive-guide-footer {
    height: 80px;
    background: var(--midnight);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 60px;
    font-size: 28px;
    color: var(--candy-pink);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
}

/* On-Demand Overlay */
.on-demand-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--midnight);
    z-index: 800;
    display: none;
    flex-direction: column;
}

.on-demand-overlay.hidden {
    display: none;
}

.on-demand-overlay:not(.hidden) {
    display: flex;
}

.on-demand-header {
    height: 150px;
    background: var(--indigo);
    border-bottom: 6px solid var(--pumpkin);
    border-style: outset;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px 96px;
}

.on-demand-title {
    font-size: 72px;
    font-weight: bold;
    color: var(--pumpkin);
    text-shadow: 4px 4px 0 rgba(0,0,0,0.8);
    margin-bottom: 10px;
}

.on-demand-subtitle {
    font-size: 28px;
    color: var(--candy-pink);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
}

.on-demand-content {
    flex: 1;
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 30px;
    padding: 40px 96px;
    overflow: hidden;
}

.on-demand-categories {
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto;
    padding-right: 20px;
}

.on-demand-category {
    background: rgba(42, 35, 112, 0.8);
    border: 3px solid var(--grape);
    border-style: inset;
    padding: 25px 30px;
    font-size: 28px;
    color: var(--cream);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
    cursor: pointer;
    transition: all 0.2s;
}

.on-demand-category.selected {
    border: 4px solid var(--pumpkin);
    border-style: outset;
    background: rgba(255, 138, 61, 0.5);
    box-shadow: 0 0 20px rgba(255, 138, 61, 0.8);
    color: var(--pumpkin);
    font-weight: bold;
}

.on-demand-programs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto;
    padding-right: 20px;
}

.on-demand-program {
    background: rgba(42, 35, 112, 0.8);
    border: 3px solid var(--grape);
    border-style: inset;
    padding: 20px 30px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 20px;
    align-items: center;
    cursor: pointer;
    transition: all 0.2s;
}

.on-demand-program.selected {
    border: 4px solid var(--pumpkin);
    border-style: outset;
    background: rgba(255, 138, 61, 0.5);
    box-shadow: 0 0 20px rgba(255, 138, 61, 0.8);
}

.on-demand-program-icon {
    font-size: 42px;
}

.on-demand-program-info {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.on-demand-program-title {
    font-size: 32px;
    color: var(--cream);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
    font-weight: bold;
}

.on-demand-program.selected .on-demand-program-title {
    color: var(--pumpkin);
}

.on-demand-program-meta {
    font-size: 22px;
    color: var(--candy-pink);
    text-shadow: 1px 1px 0 rgba(0,0,0,0.8);
}

.on-demand-program-duration {
    font-size: 28px;
    color: var(--yellow);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
    font-weight: bold;
}

.on-demand-program-progress {
    font-size: 18px;
    color: var(--candy-pink);
    text-shadow: 1px 1px 0 rgba(0,0,0,0.8);
    margin-top: 5px;
}

.on-demand-detail {
    height: 180px;
    background: var(--indigo);
    border-top: 4px solid var(--pumpkin);
    border-style: outset;
    padding: 30px 96px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.on-demand-detail-title {
    font-size: 48px;
    font-weight: bold;
    color: var(--pumpkin);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    margin-bottom: 15px;
}

.on-demand-detail-info {
    font-size: 28px;
    color: var(--yellow);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
}

.on-demand-footer {
    height: 80px;
    background: var(--midnight);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 60px;
    font-size: 28px;
    color: var(--candy-pink);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
}

/* Volume Display */
.volume-display {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(27, 23, 71, 0.95);
    border: 5px solid var(--pumpkin);
    border-style: outset;
    padding: 40px 60px;
    z-index: 800;
    display: none;
}

.volume-display.hidden {
    display: none;
}

.volume-display:not(.hidden) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
}

.volume-label {
    font-size: 42px;
    font-weight: bold;
    color: var(--pumpkin);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
}

.volume-bar-outer {
    width: 600px;
    height: 40px;
    background: rgba(0,0,0,0.5);
    border: 3px solid var(--indigo);
    border-style: inset;
}

.volume-bar-inner {
    height: 100%;
    background: var(--yellow);
    width: 50%;
    transition: width 0.1s;
}

.volume-mute {
    font-size: 36px;
    color: var(--candy-pink);
    text-shadow: 3px 3px 0 rgba(0,0,0,0.8);
    visibility: hidden;
}

.volume-mute.active {
    visibility: visible;
}

/* Help Hint */
.help-hint {
    position: absolute;
    top: 96px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(27, 23, 71, 0.9);
    border: 3px solid var(--pumpkin);
    border-style: outset;
    padding: 20px 40px;
    font-size: 28px;
    color: var(--cream);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.8);
    z-index: 900;
}

.help-hint.hidden {
    display: none;
}

/* Retro Mode Overlays */
.retro-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
    display: none;
}

.retro-overlay.hidden {
    display: none;
}

.retro-overlay:not(.hidden) {
    display: block;
}

/* 4:3 Pillarbox */
.retro-overlay:not(.hidden) .main-video {
    width: 75%;  /* 4:3 in 16:9 */
    left: 12.5%;
}

.scanlines {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0) 0px,
        rgba(0, 0, 0, 0) 2px,
        rgba(0, 0, 0, 0.1) 2px,
        rgba(0, 0, 0, 0.1) 4px
    );
    pointer-events: none;
}

.vignette {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, transparent 50%, rgba(0, 0, 0, 0.5) 100%);
    pointer-events: none;
}

/* Channel Fade Transitions */
@keyframes fadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.fade-out {
    animation: fadeOut 0.15s forwards;
}

.fade-in {
    animation: fadeIn 0.15s forwards;
}

/* Hidden utility */
.hidden {
    display: none !important;
}


/* ============================================================
   GUIDE: PiP stays visible while scrolling, click targets, "you are here"
   ============================================================ */

/* Time header stays put while the channel rows scroll under it */
.interactive-guide-grid { position: relative; }
.interactive-grid-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--midnight);
    padding-bottom: 3px;
}

/* The channel you are watching */
.current-channel > .guide-channel-cell {
    border-color: var(--pumpkin);
    background: rgba(255, 138, 61, 0.35);
    box-shadow: inset 0 0 12px rgba(255, 138, 61, 0.6);
}

/* Things you can click: what is on now, and the channel itself */
.interactive-program-cell.now-airing,
.guide-program-cell.now-airing,
.interactive-channel-row .guide-channel-cell,
.guide-channel-row .guide-channel-cell,
.mini-guide-row {
    cursor: pointer;
}
.interactive-program-cell.now-airing:hover,
.guide-program-cell.now-airing:hover {
    filter: brightness(1.35);
    outline: 3px solid var(--yellow);
    outline-offset: -3px;
}
.interactive-channel-row .guide-channel-cell:hover,
.guide-channel-row .guide-channel-cell:hover {
    filter: brightness(1.3);
}

/* Interactive guide opened beside the PiP video:
   PiP video top-left (it sits above this layer), selected-program details beside it,
   and the scrolling grid underneath. */
.interactive-guide.pip-layout {
    z-index: 340;   /* just below the PiP video (350) so the video stays visible */
}
.interactive-guide.pip-layout:not(.hidden) {
    display: grid;
    grid-template-columns: 700px 1fr;
    grid-template-rows: 80px 380px minmax(0, 1fr) 70px;
    grid-template-areas:
        "header header"
        "pip    detail"
        "grid   grid"
        "footer footer";
}
.pip-layout .interactive-guide-header {
    grid-area: header;
    height: 80px;
    padding: 0 60px;
    border-bottom-width: 4px;
}
.pip-layout .interactive-guide-title { font-size: 44px; }
.pip-layout .interactive-guide-clock { font-size: 40px; }
.pip-layout .interactive-guide-detail {
    grid-area: detail;
    height: auto;
    margin: 20px 60px 20px 0;
    padding: 20px 40px;
    border: 4px solid var(--pumpkin);
    border-style: outset;
    align-content: center;
}
.pip-layout .interactive-guide-grid {
    grid-area: grid;
    min-height: 0;
    padding: 0 60px 10px;
}
.pip-layout .interactive-guide-footer {
    grid-area: footer;
    height: 70px;
}
.pip-layout .interactive-grid-header,
.pip-layout .interactive-channel-row {
    grid-template-columns: 230px repeat(6, minmax(0, 1fr));
}
.pip-layout .guide-time-header {
    font-size: 24px;
    padding: 8px;
}
.pip-layout .interactive-program-cell {
    min-height: 72px;
    padding: 6px 8px;
    font-size: 19px;
}
.pip-layout .guide-channel-cell { padding: 6px; }
